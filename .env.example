# Copy this file to .env and fill in real values. Never commit the real .env.

# GA4 Demo Account (Google Merchandise Store) — join it here first:
# https://support.google.com/analytics/answer/6367342
GA4_PROPERTY_ID=213025502

# OAuth client for your own Google account (Google Cloud Console -> APIs & Services
# -> Credentials -> OAuth client ID -> Desktop app). Download the JSON and point to it.
GA4_OAUTH_CLIENT_SECRETS_FILE=client_secret.json
GA4_TOKEN_FILE=token.json

# Postgres landing zone
# Local Postgres: leave POSTGRES_SSLMODE unset (defaults to "disable").
# Hosted Postgres (e.g. Aiven): use the host/port/user/password from your
# provider's console, set POSTGRES_SSLMODE=require, and set
# POSTGRES_SSLROOTCERT to wherever you saved the provider's CA cert
# (Aiven calls it ca.pem, downloadable from the service Overview page).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketing_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=disable
POSTGRES_SSLROOTCERT=

# Federal Grants CSV (real data) — download from:
# https://www.kaggle.com/datasets/webdevbadger/federal-grants-and-funding-opportunities
GRANTS_CSV_PATH=data/federal_grants.csv

# Synthetic data generation (still used for the social media leg)
SYNTHETIC_SEED=42
